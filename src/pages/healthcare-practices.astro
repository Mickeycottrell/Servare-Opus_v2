---
import Layout from '../layouts/Layout.astro';
import StartConversation from '../components/StartConversation.astro';
---
<Layout
  title="Operations for Healthcare Practices"
  description="We take responsibility for the credentialing, compliance, systems, and financial operations a practice depends on."
>
  <div class="page-header">
    <div class="container">
      <h1>Operations for Healthcare Practices</h1>
      <p>We take responsibility for the credentialing, compliance, systems, and financial operations a practice depends on.</p>
    </div>
  </div>

  <section>
    <div class="container prose">
      <h2>Credentialing &amp; Compliance</h2>
      <ul>
        <li>Provider credentialing and privileging across hospitals, surgery centers, and clinical partners</li>
        <li>Payer enrollment and recredentialing — CAQH, Availity, Optum, Medicare, TMHP, BCBS, UnitedHealthcare</li>
        <li>Allied health professional hiring, credentialing, and employment coordination</li>
        <li>Malpractice and liability insurance administration, including coverage transitions and tail coverage</li>
        <li>Business entity administration — Secretary of State filings, Comptroller and franchise tax filings, compliance documentation</li>
      </ul>

      <h2>Systems &amp; Technology</h2>
      <ul>
        <li>Microsoft 365, Entra, Teams, SharePoint, and OneDrive setup, deployment, and access administration</li>
        <li>Microsoft 365, SharePoint, and Copilot training and enablement for staff and providers</li>
        <li>Clinical technology implementation — risk-assessment platforms, PACS, Epic Care Link, laboratory integration, and EHR-adjacent workflows</li>
      </ul>

      <h2>Financial &amp; Infrastructure</h2>
      <ul>
        <li>Benefits analysis, retirement-plan data, and compensation reporting</li>
        <li>SOPs, onboarding, and offboarding systems that remove single points of failure</li>
      </ul>
    </div>
  </section>

  <StartConversation />
</Layout>
