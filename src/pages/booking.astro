---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a Call">
  <div class="page-header">
    <div class="container">
      <h1>Book a Discovery Call</h1>
      <p>Pick a time that works — no pressure, just a conversation about where your time is going.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="cal-embed-wrap">
        <iframe
          src="https://cal.com/micaela-cottrell-yluv5l/discovery-call?embed=true"
          width="100%"
          height="700"
          frameborder="0"
          title="Book a discovery call"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
