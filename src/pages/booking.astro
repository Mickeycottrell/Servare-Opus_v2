---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Schedule a Consultation"
  description="Schedule a discovery call with Servare Opus to scope operations support for your healthcare practice or founder-led company."
>
  <div class="page-header">
    <div class="container">
      <h1>Schedule a Consultation</h1>
      <p>If there's alignment between what you need and what we do, this is where that gets figured out.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="cal-embed-wrap">
        <iframe
          src="https://cal.com/micaela-cottrell-yluv5l/discovery-call?embed=true"
          width="100%"
          height="700"
          frameborder="0"
          title="Book a discovery call"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
