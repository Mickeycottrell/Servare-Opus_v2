---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Book a Call">
  <div class="page-header">
    <div class="container">
      <h1>Book a Discovery Call</h1>
      <p>Pick a time that works — no pressure, just a conversation about where your time is going.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="cal-embed-wrap">
        <!-- Cal.com inline embed. Replace "your-username/discovery-call" with your real Cal.com link
             once you've created a free account at https://cal.com and set up an event type. -->
        <iframe
          src="https://cal.com/your-username/discovery-call?embed=true"
          width="100%"
          height="700"
          frameborder="0"
          title="Book a discovery call"
        ></iframe>
      </div>
      <div class="note-box">
        <strong>Setup note:</strong> This calendar is a placeholder. Create a free account at
        <a href="https://cal.com" target="_blank" rel="noopener">cal.com</a>, set up a "Discovery Call" event type,
        and swap the URL in <code>src/pages/booking.astro</code> for your real booking link (it will look like
        <code>cal.com/your-username/discovery-call</code>). See the deployment guide for full steps.
      </div>
    </div>
  </section>
</Layout>
