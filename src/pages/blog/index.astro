---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout
  title="Blog"
  description="Notes from Servare Opus on operations, credentialing, compliance, and running a leaner, more scalable business."
>
  <div class="page-header">
    <div class="container">
      <h1>Blog</h1>
      <p>Notes on operations, systems, and running a business that doesn't depend on any one person.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-item">
            <div class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
            <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
