---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Services">
  <div class="page-header">
    <div class="container">
      <h1>Services</h1>
      <p>Executive support, scoped to how you actually work.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="grid-3">
        <div class="card">
          <h3>Calendar Management</h3>
          <p>Proactive scheduling, conflict resolution, meeting prep, and protecting focus time so your day reflects your actual priorities.</p>
        </div>
        <div class="card">
          <h3>Inbox Triage</h3>
          <p>Daily inbox management — flagged priorities, drafted responses, and a clear line between what needs you and what doesn't.</p>
        </div>
        <div class="card">
          <h3>Travel Planning</h3>
          <p>Flights, hotels, ground transport, and itineraries built around how you like to travel, with backups ready before you need them.</p>
        </div>
        <div class="card">
          <h3>Board &amp; Investor Support</h3>
          <p>Board meeting logistics, deck coordination, investor update scheduling, and data-room housekeeping handled with discretion.</p>
        </div>
        <div class="card">
          <h3>Project &amp; Vendor Coordination</h3>
          <p>Chasing down vendors, tracking action items across teams, and keeping the small projects moving without you in the loop on every step.</p>
        </div>
        <div class="card">
          <h3>Personal &amp; Life Ops</h3>
          <p>Appointments, reservations, gifting, household logistics — the personal admin that frees up real mental bandwidth.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Engagement options</h2>
        <p>Every engagement starts with a discovery call so we can match you with the right EA and scope hours honestly.</p>
      </div>
      <div class="pricing-grid">
        <div class="price-card">
          <h3>Starter</h3>
          <div class="price">10 hrs/wk</div>
          <ul>
            <li>Calendar &amp; inbox management</li>
            <li>Meeting scheduling &amp; prep</li>
            <li>Monthly strategy check-in</li>
          </ul>
          <a href="/booking" class="btn">Book a Call</a>
        </div>
        <div class="price-card featured">
          <h3>Growth</h3>
          <div class="price">20 hrs/wk</div>
          <ul>
            <li>Everything in Starter</li>
            <li>Travel &amp; logistics planning</li>
            <li>Project &amp; vendor coordination</li>
            <li>Weekly priorities sync</li>
          </ul>
          <a href="/booking" class="btn">Book a Call</a>
        </div>
        <div class="price-card">
          <h3>Executive</h3>
          <div class="price">30+ hrs/wk</div>
          <ul>
            <li>Everything in Growth</li>
            <li>Board &amp; investor support</li>
            <li>Personal &amp; life ops</li>
            <li>Priority same-day coverage</li>
          </ul>
          <a href="/booking" class="btn">Book a Call</a>
        </div>
      </div>
      <p style="text-align:center; color:var(--gray); margin-top:28px; font-size:0.9rem;">Exact pricing is confirmed after your discovery call, based on scope and hours.</p>
    </div>
  </section>
</Layout>
