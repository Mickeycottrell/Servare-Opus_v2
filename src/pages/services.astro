---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Services — Healthcare & Business Operations"
  description="Fractional operations support covering Microsoft 365 administration, credentialing, payer enrollment, financial reporting, vendor management, and process infrastructure."
>
  <div class="page-header">
    <div class="container">
      <h1>Services</h1>
      <p>Executive support, scoped to how you actually work.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <div class="grid-3">
        <div class="card">
          <h3>Healthcare Operations</h3>
          <ul>
            <li>Microsoft 365, Teams, SharePoint, and clinical system setup, deployment, and administration</li>
            <li>Credentialing and hospital privileging across hospitals, surgery centers, and clinical partners</li>
            <li>Payer enrollment and recredentialing — CAQH, Availity, Medicare, commercial payers</li>
            <li>Malpractice and liability insurance administration</li>
            <li>Financial proformas, benefits analysis, and compensation reporting</li>
            <li>SOPs, onboarding, and offboarding systems</li>
          </ul>
        </div>
        <div class="card">
          <h3>Business Operations</h3>
          <ul>
            <li>Microsoft 365 and business systems setup, deployment, and administration</li>
            <li>Financial proformas and forecasting</li>
            <li>Vendor and supplier management, including international sourcing</li>
            <li>Market, regulatory, and competitive research</li>
            <li>Executive reporting and decision-ready briefs</li>
            <li>Process documentation and operational infrastructure</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="container">
      <div class="section-head">
        <h2>Engagements</h2>
        <p>Every engagement begins with a discovery call to define scope.</p>
      </div>
      <div class="actions" style="justify-content:center; display:flex;">
        <a href="/booking" class="btn">Schedule a Discovery Call</a>
      </div>
    </div>
  </section>
</Layout>
