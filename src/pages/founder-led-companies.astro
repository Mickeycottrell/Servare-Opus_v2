---
import Layout from '../layouts/Layout.astro';
import StartConversation from '../components/StartConversation.astro';
---
<Layout
  title="Operations for Founder-Led Companies"
  description="We take responsibility for the research, vendor decisions, systems, and reporting your business depends on."
>
  <div class="page-header">
    <div class="container">
      <h1>Operations for Founder-Led Companies</h1>
      <p>We take responsibility for the research, vendor decisions, systems, and reporting your business depends on.</p>
    </div>
  </div>

  <section>
    <div class="container prose">
      <h2>Research &amp; Intelligence</h2>
      <ul>
        <li>Market, regulatory, and international trade research</li>
        <li>Vendor and technology-platform evaluation, including data and API comparison</li>
        <li>Business model and competitive assessment — products, market position, and growth opportunities</li>
      </ul>

      <h2>Systems &amp; Vendor Management</h2>
      <ul>
        <li>Microsoft 365 and business systems setup, deployment, and administration</li>
        <li>Enterprise AI and technology strategy — evaluating and architecting internal AI and data-platform initiatives</li>
        <li>Vendor, supplier, and international partner coordination, including sourcing and trade logistics</li>
      </ul>

      <h2>Financial &amp; Reporting</h2>
      <ul>
        <li>Financial proformas and forecasting</li>
        <li>Executive reporting structured for decisions, not activity</li>
        <li>Documentation and infrastructure that scales independent of any one person</li>
      </ul>
    </div>
  </section>

  <StartConversation />
</Layout>
