---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact"
  description="Get in touch with Servare Opus to discuss operations support for your healthcare practice or founder-led business."
>
  <div class="page-header">
    <div class="container">
      <h1>Get in Touch</h1>
      <p>Have a question before scheduling a consultation? Send a note.</p>
    </div>
  </div>

  <section>
    <div class="container">
      <form class="contact-form" action="https://formspree.io/f/xdenzzer" method="POST">
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div>
          <label for="company">Company</label>
          <input type="text" id="company" name="company" />
        </div>
        <div>
          <label for="message">How can we help?</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="btn">Send Message</button>
      </form>
    </div>
  </section>
</Layout>
